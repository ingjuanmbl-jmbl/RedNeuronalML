a"],"metadata":{"id":"SwMRcLZ01X2H"}},{"cell_type":"code","source":["# Validación cruzada estratificada\n","cv = StratifiedKFold(\n","    n_splits=5,\n","    shuffle=True,\n","    random_state=SEED\n",")\n","\n","# Parámetros de entrenamiento\n","MAX_EPOCHS = 200\n","PATIENCE = 20\n","\n","print(\"Número de particiones:\", cv.get_n_splits())\n","print(\"Máximo de epochs:\", MAX_EPOCHS)\n","print(\"Paciencia Early Stopping:\", PATIENCE)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"u0rfVMTv1LYn","executionInfo":{"status":"ok","timestamp":1793984947729,"user_tz":300,"elapsed":7,"user":{"displayName":"JUAN MANUEL BETANCUR LOPEZ","userId":"09952323565785544167"}},"outputId":"6aa1cffb-00de-48bd-96d3-96d6e949768a"},"execution_count":24,"outputs":[{"output_type":"stream","name":"stdout","text":["Número de particiones: 5\n","Máximo de epochs: 200\n","Paciencia Early Stopping: 20\n"]}]},{"cell_type":"markdown","source":["Cada configuración se entrenará cinco veces, utilizando una partición diferente para validación.\n","\n","### búsqueda de hiperparámetros\n","\n","Esta es la celda principal. Para cada configuración:\n","\n","1. Divide los datos en cinco particiones.\n","2. Ajusta el preprocesador exclusivamente con los datos de entrenamiento de cada pliegue.\n","3. Construye la red neuronal.\n","4. Entrena con Early Stopping.\n","5. Calcula las métricas sobre la partición de validación.\n","6. Registra los resultados."],"metadata":{"id":"rSEP-pVT1kvA"}},{"cell_type":"code","source":["resultados_optimizacion = []\n","\n","for numero, config in enumerate(configuraciones, start=1):\n","\n","    print(f\"\\nConfiguración {numero}/{len(configuraciones)}\")\n","    print(config)\n","\n","    metricas_folds = []\n","    mejores_epochs = []\n","\n","    # Validación cruzada\n","    for fold, (idx_train, idx_val) in enumerate(\n","        cv.split(X_train_full, y_train_full), start=1\n","    ):\n","\n","        keras.backend.clear_session()\n","        tf.keras.utils.set_random_seed(SEED + fold)\n","\n","        # Separar datos del pliegue\n","        X_fold_train = X_train_full.iloc[idx_train]\n","        X_fold_val = X_train_full.iloc[idx_val]\n","\n","        y_fold_train = y_train_full.iloc[idx_train].to_numpy(\n","            dtype=np.float32\n","        )\n","        y_fold_val = y_train_full.iloc[idx_val].to_numpy(\n","            dtype=np.float32\n","        )\n","\n","        # Clonar y ajustar el preprocesador dentro del pliegue\n","        preprocessor_fold = clone(preprocessor)\n","\n","        X_fold_train_nn = preprocessor_fold.fit_transform(\n","            X_fold_train\n","        )\n","\n","        X_fold_val_nn = preprocessor_fold.transform(\n","            X_fold_val\n","        )\n","\n","        X_fold_train_nn = np.asarray(\n","            X_fold_train_nn, dtype=np.float32\n","        )\n","\n","        X_fold_val_nn = np.asarray(\n","            X_fold_val_nn, dtype=np.float32\n","        )\n","\n","        # Construir modelo\n","        model = construir_mlp(\n","            input_dim=X_fold_train_nn.shape[1],\n","            neuronas_capa_1=config['neuronas_capa_1'],\n","            neuronas_capa_2=config['neuronas_capa_2'],\n","            dropout=config['dropout'],\n","            learning_rate=config['learning_rate'],\n","            l2=config['l2']\n","        )\n","\n","        # Early Stopping\n","        early_stop = keras.callbacks.EarlyStopping(\n","            monitor='val_loss',\n","            patience=PATIENCE,\n","            restore_best_weights=True,\n","            verbose=0\n","        )\n","\n","        # Entrenamiento\n","        history_cv = model.fit(\n","            X_fold_train_nn,\n","            y_fold_train,\n","            validation_data=(\n","                X_fold_val_nn,\n","                y_fold_val\n","            ),\n","            epochs=MAX_EPOCHS,\n","            batch_size=config['batch_size'],\n","            callbacks=[early_stop],\n","            verbose=0\n","        )\n","\n","        # Mejor epoch\n","        mejor_epoch = (\n","            np.argmin(history_cv.history['val_loss']) + 1\n","        )\n","\n","        mejores_epochs.append(mejor_epoch)\n","\n","        # Predicciones de validación\n","        y_prob_fold = model.predict(\n","            X_fold_val_nn,\n","            verbose=0\n","        ).ravel()\n","\n","        y_pred_fold = (\n","            y_prob_fold >= 0.5\n","        ).astype(int)\n","\n","        # Métricas\n","        metricas_fold = {\n","            'accuracy': accuracy_score(\n","                y_fold_val, y_pred_fold\n","            ),\n","            'precision': precision_score(\n","                y_fold_val, y_pred_fold, zero_division=0\n","            ),\n","            'recall': recall_score(\n","                y_fold_val, y_pred_fold, zero_division=0\n","            ),\n","            'f1_score': f1_score(\n","                y_fold_val, y_pred_fold, zero_division=0\n","            ),\n","            'roc_auc': roc_auc_score(\n","                y_fold_val, y_prob_fold\n","            )\n","        }\n","\n","        metricas_folds.append(metricas_fold)\n","\n","    # Consolidar resultados de los cinco pliegues\n","    df_folds = pd.DataFrame(metricas_folds)\n","\n","    resultado = {\n","        **config,\n","\n","        'accuracy_mean': df_folds['accuracy'].mean(),\n","        'precision_mean': df_folds['precision'].mean(),\n","        'recall_mean': df_folds['recall'].mean(),\n","        'f1_mean': df_folds['f1_score'].mean(),\n","        'roc_auc_mean': df_folds['roc_auc'].mean(),\n","\n","        'roc_auc_std': df_folds['roc_auc'].std(),\n","        'best_epochs_mean': np.mean(mejores_epochs),\n","        'best_epochs_median': int(\n","            np.median(mejores_epochs)\n","        )\n","    }\n","\n","    resultados_optimizacion.append(resultado)\n","\n","    print(\n","        f\"ROC-AUC promedio: \"\n","        f\"{resultado['roc_auc_mean']:.4f}\"\n","    )\n","\